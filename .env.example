# XAR local
PORT=8791
XAR_ENV=dev
XAR_STORAGE=json
XAR_JSON_PATH=./xpacks.json
XAR_BLOB=files
XAR_DATA_DIR=./files
# XAR_CORS_ORIGINS=https://your-site.com
# XAR_API_KEY=change-this-in-prod-only

# Docker/OCI: served by OnMind-XCR as a dependency (onmind-xcr at /v2/*).
# on = mount XCR when installed, off = /v2/* 404.
# XAR_DOCKER=on
# XCR storage for images (independent from XAR metadata):
# XCR_STORAGE=filesystem
XCR_DATA_DIR=./xcr-data
# XCR_STORAGE=s3
# XCR_S3_BUCKET=xar-docker
# XCR_S3_PREFIX=docker-registry/

# DynamoDB + S3 (Lambda / Floci / LocalStack / RustFS)
# XAR_STORAGE=dynamodb
# XAR_TABLE_REPOS=xrepos
# XAR_TABLE_ARTIFACTS=xartifacts
# AWS_REGION=eu-west-1
# XAR_DYNAMO_ENDPOINT=http://localhost:8000
# XAR_BLOB=s3
# XAR_S3_BUCKET=xar-artifacts
# XAR_S3_PREFIX=artifacts/
# XAR_S3_ENDPOINT=http://localhost:9000
# XAR_S3_REGION=us-east-1
